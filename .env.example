# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findmyapprtment?schema=public"

# Database credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=findmyapprtment

# Telegram Bot Alerts Configuration
# Insert your Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Insert your Chat ID or Channel/Group ID from @userinfobot or @raw_data_bot
TELEGRAM_CHAT_ID="your_chat_id_here"

# Hourly Scraper Cron Schedule (default: every hour at minute 0)
CRON_SCHEDULE="0 * * * *"

# Target City & District
TARGET_CITY="קרית גת"
TARGET_CITY_SLUG="kiryat-gat"
TARGET_DISTRICT="כרמי גת"
TARGET_DISTRICT_SLUG="karmei-gat"

# Application Port
PORT=3000

# Optional: Enable verbose debug logging (true/false)
DEBUG=false
